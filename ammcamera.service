[Unit]
Description=AmRoute Camera
Wants=network-online.target
After=network-online.target

[Service]
User=pi
Group=pi
WorkingDirectory=/home/pi/AMMcamera
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 ammcamera.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
